{
  "payload_id": "PAYLOAD-EDGE-01",
  "platform": "Group 3 UAS",
  "swap_constraints": {
    "max_weight_lbs": 20,
    "max_power_watts": 250,
    "governance_binary_size_mb": 20,
    "governance_power_watts": 2
  },
  "sensors": [
    {
      "sensor_id": "SIGINT-01",
      "type": "Broadband SIGINT Receiver",
      "agent_id": "agent-sigint",
      "status": "active",
      "frequency_range_mhz": "20-6000",
      "power_watts": 15,
      "weight_lbs": 2.5,
      "capabilities": ["rf_detection", "signal_classification", "geolocation", "cross_cue_request"]
    },
    {
      "sensor_id": "EOIR-01",
      "type": "EO/IR Gimbal Camera",
      "agent_id": "agent-eoir",
      "status": "standby",
      "power_watts": 25,
      "weight_lbs": 3.0,
      "capabilities": ["electro_optical", "infrared", "low_light", "slew_to_coordinates", "track_target"]
    },
    {
      "sensor_id": "PNT-FUSION-01",
      "type": "PNT Fusion Engine",
      "agent_id": "agent-pnt-fusion",
      "status": "active",
      "power_watts": 5,
      "weight_lbs": 0.5,
      "capabilities": ["gnss", "visual_odometry", "magnav", "spoofing_detection", "consensus_voting"],
      "inputs": ["GNSS-1", "VO-1", "MAG-1", "GNSS-SPOOF-1"]
    }
  ],
  "actuators": [
    {
      "actuator_id": "GIMBAL-CTRL-01",
      "type": "Gimbal Slew Controller",
      "operator_managed": true,
      "max_slew_rate_dps": 60,
      "safety_limits": {"max_azimuth_deg": 360, "max_elevation_deg": 90}
    },
    {
      "actuator_id": "FLIGHT-CTRL-01",
      "type": "Flight Controller Interface",
      "operator_managed": true,
      "safety_limits": {"max_altitude_ft": 18000, "max_speed_kts": 150}
    }
  ],
  "datalink": {
    "type": "tactical-datalink",
    "status": "connected",
    "bandwidth_kbps": 256,
    "latency_ms": 450,
    "encryption": "AES-256-GCM",
    "disconnected_behavior": "continue_local_governance"
  },
  "governance_config": {
    "posture": "consensus",
    "tribunal_members": 3,
    "quorum": 2,
    "bft_enabled": true,
    "fail_closed": true,
    "local_ledger": true,
    "local_audit_vault": true
  }
}
