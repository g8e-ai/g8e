"""Type stubs for dynamically-generated protocol enums.

This module provides Pyright and static analyzers with type information
for enums that are generated at runtime by ``g8e.enums`` from protocol
constants.
"""

from enum import IntEnum, StrEnum
from typing import Any

class CaseInsensitiveStrEnum(StrEnum):
    """StrEnum that accepts case-insensitive string lookups."""
    @classmethod
    def _missing_(cls, value: object) -> Any: ...


