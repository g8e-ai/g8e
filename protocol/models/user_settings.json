{
  "_comment": "Canonical UserSettings document shape. client is the authority - it creates and updates this document in the settings collection. The g8e-compatible ensemble reads it at request time. Settings are grouped into nested sub-objects (llm, search, eval_judge).",

  "_authority": "client",
  "_consumers": ["agent"],
  "_collection": "settings",
  "_document_id": "user_settings_{user_id}",

  "user_settings": {
    "_description": "Per-user settings document. Top-level fields include user_id and timestamps from G8eIdentifiableModel. The settings object contains nested groups.",

    "user_id": {
      "type": "string",
      "required": true,
      "description": "User identifier. Must match the {user_id} portion of the document ID."
    },

    "settings": {
      "llm": {
        "_description": "Maps to LLMSettings model. Uses generic provider fields instead of provider-specific keys. Aliases shown in brackets.",
        "llm_primary_provider":   { "type": "string",  "required": false, "description": "Primary LLM provider (alias: primary_provider)" },
        "llm_assistant_provider": { "type": "string",  "required": false, "description": "Assistant LLM provider (alias: assistant_provider)" },
        "llm_lite_provider":      { "type": "string",  "required": false, "description": "Lite LLM provider (alias: lite_provider)" },
        "llm_model":              { "type": "string",  "required": false, "description": "Primary LLM model name (alias: primary_model)" },
        "llm_assistant_model":    { "type": "string",  "required": false, "description": "Assistant LLM model name (alias: assistant_model)" },
        "llm_lite_model":         { "type": "string",  "required": false, "description": "Lite LLM model name (alias: lite_model)" },
        "primary_api_key":        { "type": "string",  "required": false, "description": "Primary provider API key" },
        "primary_endpoint":       { "type": "string",  "required": false, "description": "Primary provider endpoint URL" },
        "assistant_api_key":      { "type": "string",  "required": false, "description": "Assistant provider API key" },
        "assistant_endpoint":     { "type": "string",  "required": false, "description": "Assistant provider endpoint URL" },
        "lite_api_key":           { "type": "string",  "required": false, "description": "Lite provider API key" },
        "lite_endpoint":          { "type": "string",  "required": false, "description": "Lite provider endpoint URL" }
      },
      "search": {
        "_description": "Maps to SearchSettings model.",
        "enabled":    { "type": "boolean", "required": false },
        "project_id": { "type": "string",  "required": false },
        "engine_id":  { "type": "string",  "required": false },
        "location":   { "type": "string",  "required": false, "default": "global" },
        "api_key":    { "type": "string",  "required": false }
      },
      "eval_judge": {
        "_description": "Maps to EvalJudgeSettings model. Keys use alias names.",
        "eval_judge_model":       { "type": "string",  "required": false },
        "eval_judge_max_tokens":  { "type": "integer", "required": false }
      },
      "command_validation": {
        "_description": "Maps to CommandValidationSettings model. Operator command safety and validation configuration.",
        "enable_whitelisting":    { "type": "boolean", "required": false, "default": false },
        "whitelisted_commands":   { "type": "string",  "required": false, "default": "" },
        "enable_blacklisting":    { "type": "boolean", "required": false, "default": true }
      },
      "batch_execution": {
        "_description": "Maps to BatchExecutionSettings model. Batch execution configuration for Operator tools.",
        "max_concurrency": { "type": "integer", "required": false, "default": 10, "description": "Maximum concurrent tool executions (1-64)" },
        "fail_fast":       { "type": "boolean", "required": false, "default": false }
      }
    },

    "timestamps": {
      "created_at": {
        "type": "string",
        "format": "iso8601",
        "required": true,
        "description": "Managed by G8eIdentifiableModel."
      },
      "updated_at": {
        "type": "string",
        "format": "iso8601",
        "required": true,
        "description": "Managed by G8eIdentifiableModel."
      }
    }
  }
}
