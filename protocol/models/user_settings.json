{
  "_comment": "Canonical UserSettings document shape. client is the authority - it creates and updates this document in the settings collection. The g8e-compatible ensemble reads it at request time. Settings are grouped into nested sub-objects (llm, search, eval_judge).",

  "_authority": "client",
  "_consumers": ["agent"],
  "_collection": "settings",
  "_document_id": "user_settings_{user_id}",

  "user_settings": {
    "_description": "Per-user settings document. Top-level fields include user_id and timestamps from G8eIdentifiableModel. The settings object contains nested groups.",

    "user_id": {
      "type": "string",
      "required": true,
      "description": "User identifier. Must match the {user_id} portion of the document ID."
    },

    "settings": {
      "llm": {
        "_description": "Maps to LLMSettings model.",
        "provider":              { "type": "string",  "required": false, "values": ["openai", "ollama", "gemini", "anthropic"] },
        "llm_model":             { "type": "string",  "required": false, "description": "Primary LLM model name (alias for primary_model)." },
        "llm_assistant_model":   { "type": "string",  "required": false, "description": "Assistant LLM model name (alias for assistant_model)." },
        "openai_endpoint":       { "type": "string",  "required": false },
        "openai_api_key":        { "type": "string",  "required": false },
        "ollama_endpoint":       { "type": "string",  "required": false },
        "ollama_api_key":        { "type": "string",  "required": false },
        "gemini_api_key":        { "type": "string",  "required": false },
        "anthropic_endpoint":    { "type": "string",  "required": false },
        "anthropic_api_key":     { "type": "string",  "required": false },
        "llm_max_tokens":        { "type": "integer", "required": false },
        "llm_command_gen_enabled":  { "type": "boolean", "required": false },
        "llm_command_gen_verifier": { "type": "boolean", "required": false },
        "llm_command_gen_passes":   { "type": "integer", "required": false }
      },
      "search": {
        "_description": "Maps to SearchSettings model.",
        "enabled":    { "type": "boolean", "required": false },
        "project_id": { "type": "string",  "required": false },
        "engine_id":  { "type": "string",  "required": false },
        "location":   { "type": "string",  "required": false, "default": "global" },
        "api_key":    { "type": "string",  "required": false }
      },
      "eval_judge": {
        "_description": "Maps to EvalJudgeSettings model. Keys use alias names.",
        "eval_judge_model":       { "type": "string",  "required": false },
        "eval_judge_max_tokens":  { "type": "integer", "required": false }
      }
    },

    "timestamps": {
      "created_at": {
        "type": "string",
        "format": "iso8601",
        "required": true,
        "description": "Managed by G8eIdentifiableModel."
      },
      "updated_at": {
        "type": "string",
        "format": "iso8601",
        "required": true,
        "description": "Managed by G8eIdentifiableModel."
      }
    }
  }
}
