{
  "cache.prefix": "g8e",
  "key.schema": {
    "CacheDoc": "g8e:cache:doc:{collection}:{id}",
    "CacheQuery": "g8e:cache:query:{collection}:{hash}",
    "OperatorBind": "g8e:session:operator:{operator.session.id}:bind",
    "SessionWeb": "g8e:session:{session.type}:{session.id}",
    "UserMemories": "g8e:user:{user.id}:memories",
    "UserOperators": "g8e:user:{user.id}:operators",
