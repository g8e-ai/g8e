{
  "mcpServers": {
    "g8e-gateway": {
      "transport": {
        "type": "http",
        "url": "https://g8e.local:8443/mcp"
      },
      "tls": {
        "clientCertificateEnv": "G8E_CLIENT_CERT",
        "clientKeyEnv": "G8E_CLIENT_KEY",
        "caCertificateEnv": "G8E_CA_BUNDLE",
        "verifyServer": true,
        "verifyHostname": "g8e.local"
      },
      "capabilities": {
        "tools": true,
        "resources": true,
        "prompts": true
      },
      "description": "g8e Gateway MCP endpoint (env-var TLS)",
      "notes": [
        "mTLS is required for production access.",
        "Set G8E_CLIENT_CERT, G8E_CLIENT_KEY, and G8E_CA_BUNDLE environment variables to the respective file paths."
      ]
    }
  }
}
