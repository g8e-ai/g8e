{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "description": "Schema for SSE event fixtures. Validates the structure of shared SSE event test fixtures to ensure field name consistency across components. The data payload may include routing fields (web_session_id, cli_session_id, user_id) and event-specific fields defined by the Python wire models in protocol/python/g8e/models/events.py.",
  "type": "object",
  "additionalProperties": {
    "type": "object",
    "required": [
      "type",
      "data"
    ],
    "properties": {
      "type": {
        "type": "string",
        "description": "Event type identifier matching EventType constants"
      },
      "data": {
        "type": "object",
        "description": "Event payload data",
        "additionalProperties": true,
        "required": [
          "web_session_id"
        ],
        "properties": {
          "web_session_id": {
            "type": "string",
            "description": "Web UI session identifier (routing field)"
          },
          "cli_session_id": {
            "type": "string",
            "description": "CLI / BYO session identifier (routing field, mutually exclusive with web_session_id and user_id)"
          },
          "user_id": {
            "type": "string",
            "description": "User identifier for background fan-out events (routing field)"
          },
          "agent_mode": {
            "type": "string",
            "description": "Agent mode for chat events (e.g., g8e.operator.bound, g8e.not.bound)"
          },
          "timestamp": {
            "type": [
              "string",
              "null"
            ],
            "description": "UTC timestamp of the event"
          },
          "tool_name": {
            "type": "string",
            "description": "Canonical name of the tool"
          },
          "status": {
            "type": "string",
            "description": "Lifecycle status of the tool call (started, completed, failed)"
          },
          "display_label": {
            "type": [
              "string",
              "null"
            ]
          },
          "display_icon": {
            "type": [
              "string",
              "null"
            ]
          },
          "display_detail": {
            "type": [
              "string",
              "null"
            ]
          },
          "category": {
            "type": [
              "string",
              "null"
            ]
          },
          "investigation_id": {
            "type": "string",
            "description": "Investigation identifier (required for non-platform events)"
          },
          "case_id": {
            "type": "string",
            "description": "Case identifier (required for non-platform events)"
          },
          "execution_id": {
            "type": "string",
            "description": "Execution identifier for command/tool events"
          },
          "content": {
            "type": "string",
            "description": "Text content for LLM events"
          },
          "error": {
            "type": "string",
            "description": "Error message for failed events"
          },
          "query": {
            "type": "string",
            "description": "Search query for web search events"
          },
          "results": {
            "type": "array",
            "description": "Search results for web search completed events",
            "items": {
              "type": "object",
              "properties": {
                "title": {
                  "type": "string"
                },
                "url": {
                  "type": "string"
                },
                "link": {
                  "type": "string",
                  "description": "Result URL (alternative to url field)"
                },
                "snippet": {
                  "type": "string"
                }
              }
            }
          },
          "port": {
            "type": "string",
            "description": "Port number for port check events"
          },
          "host": {
            "type": "string",
            "description": "Hostname for port check events"
          },
          "is_open": {
            "type": "boolean",
            "description": "Port open status for port check completed events"
          },
          "grounding_used": {
            "type": "boolean",
            "description": "Whether grounding was used for citations"
          },
          "chunks": {
            "type": "array",
            "description": "Citation chunks",
            "items": {
              "type": "object",
              "properties": {
                "text": {
                  "type": "string"
                },
                "source": {
                  "type": "object",
                  "properties": {
                    "uri": {
                      "type": "string"
                    },
                    "title": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "sources_count": {
            "type": "number",
            "description": "Number of sources"
          },
          "query_list": {
            "type": "array",
            "description": "List of queries used",
            "items": {
              "type": "string"
            }
          },
          "command": {
            "type": "string",
            "description": "Command string for Operator command events"
          },
          "output": {
            "type": "string",
            "description": "Command output for completed events"
          },
          "exit_code": {
            "type": "number",
            "description": "Exit code for command events"
          },
          "success": {
            "type": "boolean",
            "description": "Success flag for command events"
          },
          "finish_reason": {
            "type": "string",
            "description": "LLM finish reason"
          },
          "has_citations": {
            "type": "boolean"
          },
          "token_usage": {
            "type": "object"
          },
          "grounding_metadata": {
            "type": "object"
          },
          "turn": {
            "type": "number"
          },
          "thinking": {
            "type": [
              "string",
              "null"
            ]
          },
          "action_type": {
            "type": "string",
            "description": "Thinking action type (started, update, end)"
          },
          "reason": {
            "type": "string",
            "description": "Stop reason for AI processing stopped events"
          },
          "attempt": {
            "type": "number",
            "description": "Retry attempt number for chat retry events"
          },
          "max_attempts": {
            "type": "number",
            "description": "Maximum retry attempts for chat retry events"
          },
          "questions": {
            "type": "array",
            "description": "Clarification questions for triage events",
            "items": {
              "type": "string"
            }
          },
          "complexity": {
            "type": "string",
            "description": "Complexity assessment for triage clarification"
          },
          "complexity_confidence": {
            "type": "string",
            "description": "Confidence score for complexity assessment"
          },
          "intent": {
            "type": "string",
            "description": "Detected intent for triage clarification"
          },
          "intent_confidence": {
            "type": "string",
            "description": "Confidence score for intent detection"
          },
          "intent_summary": {
            "type": "string",
            "description": "Summary of detected intent"
          },
          "request_posture": {
            "type": "string",
            "description": "Request posture assessment for triage"
          },
          "posture_confidence": {
            "type": "string",
            "description": "Confidence score for posture assessment"
          }
        }
      }
    }
  }
}