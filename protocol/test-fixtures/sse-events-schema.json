{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "description": "Schema for SSE event fixtures. Validates the structure of shared SSE event test fixtures to ensure field name consistency across components.",
  "type": "object",
  "additionalProperties": {
    "type": "object",
    "required": [
      "type",
      "data"
    ],
    "properties": {
      "type": {
        "type": "string",
        "description": "Event type identifier matching EventType constants"
      },
      "data": {
        "type": "object",
        "description": "Event payload data",
        "required": [
          "web_session_id"
        ],
        "properties": {
          "timestamp": {
            "type": [
              "string",
              "null"
            ],
            "description": "UTC timestamp of the event"
          },
          "tool_name": {
            "type": "string",
            "description": "Canonical name of the tool"
          },
          "status": {
            "type": "string",
            "description": "Lifecycle status of the tool call (started, completed, failed)"
          },
          "display_label": {
            "type": [
              "string",
              "null"
            ]
          },
          "display_icon": {
            "type": [
              "string",
              "null"
            ]
          },
          "display_detail": {
            "type": [
              "string",
              "null"
            ]
          },
          "category": {
            "type": [
              "string",
              "null"
            ]
          },
          "investigation_id": {
            "type": "string",
            "description": "Investigation identifier (required for non-platform events)"
          },
          "case_id": {
            "type": "string",
            "description": "Case identifier (required for non-platform events)"
          },
          "execution_id": {
            "type": "string",
            "description": "Execution identifier for command/tool events"
          },
          "content": {
            "type": "string",
            "description": "Text content for LLM events"
          },
          "error": {
            "type": "string",
            "description": "Error message for failed events"
          },
          "query": {
            "type": "string",
            "description": "Search query for web search events"
          },
          "results": {
            "type": "array",
            "description": "Search results for web search completed events",
            "items": {
              "type": "object",
              "properties": {
                "title": {
                  "type": "string"
                },
                "url": {
                  "type": "string"
                },
                "snippet": {
                  "type": "string"
                }
              }
            }
          },
          "port": {
            "type": "string",
            "description": "Port number for port check events"
          },
          "host": {
            "type": "string",
            "description": "Hostname for port check events"
          },
          "is_open": {
            "type": "boolean",
            "description": "Port open status for port check completed events"
          },
          "grounding_used": {
            "type": "boolean",
            "description": "Whether grounding was used for citations"
          },
          "chunks": {
            "type": "array",
            "description": "Citation chunks",
            "items": {
              "type": "object",
              "properties": {
                "text": {
                  "type": "string"
                },
                "source": {
                  "type": "object",
                  "properties": {
                    "uri": {
                      "type": "string"
                    },
                    "title": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "sources_count": {
            "type": "number",
            "description": "Number of sources"
          },
          "query_list": {
            "type": "array",
            "description": "List of queries used",
            "items": {
              "type": "string"
            }
          },
          "command": {
            "type": "string",
            "description": "Command string for operator command events"
          },
          "output": {
            "type": "string",
            "description": "Command output for completed events"
          },
          "exit_code": {
            "type": "number",
            "description": "Exit code for command events"
          },
          "success": {
            "type": "boolean",
            "description": "Success flag for command events"
          },
          "finish_reason": {
            "type": "string",
            "description": "LLM finish reason"
          },
          "has_citations": {
            "type": "boolean"
          },
          "token_usage": {
            "type": "object"
          },
          "grounding_metadata": {
            "type": "object"
          },
          "turn": {
            "type": "number"
          },
          "thinking": {
            "type": [
              "string",
              "null"
            ]
          },
          "action_type": {
            "type": "string"
          }
        }
      }
    }
  }
}