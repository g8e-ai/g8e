{
  "_comment": "Cross-language test vectors for investigation conversation ledger hash parity. The agent is the authority for hash computation (ensemble/app/utils/ledger_hash.py). client and other consumers must reproduce identical canonical JSON encodings, entry hashes, genesis hashes, and chain verification results. These fixtures are consumed by ensemble/tests/unit/utils/test_ledger_hash_fixtures.py and the client JS verifier test (ledger-verify-fixtures.spec.js).",
  "_authority": "agent",
  "_consumers": ["client"],

  "canonical_json": [
    {
      "name": "simple_flat",
      "input": { "a": 1, "b": 2 },
      "expected_utf8": "{\"a\":1,\"b\":2}"
    },
    {
      "name": "reverse_key_order",
      "input": { "z": 1, "a": 2, "m": 3 },
      "expected_utf8": "{\"a\":2,\"m\":3,\"z\":1}"
    },
    {
      "name": "nested_object",
      "input": { "a": 1, "b": { "c": 2, "d": [3, 4] } },
      "expected_utf8": "{\"a\":1,\"b\":{\"c\":2,\"d\":[3,4]}}"
    },
    {
      "name": "unicode",
      "input": { "name": "café", "emoji": "🔒" },
      "expected_utf8": "{\"emoji\":\"🔒\",\"name\":\"café\"}"
    },
    {
      "name": "empty_object",
      "input": {},
      "expected_utf8": "{}"
    }
  ],

