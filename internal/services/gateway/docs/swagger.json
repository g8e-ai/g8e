{
    "swagger": "2.0",
    "info": {
        "contact": {}
    },
    "paths": {
        "/": {
            "get": {
                "description": "Returns the public landing page for the gateway",
                "consumes": [
                    "text/html"
                ],
                "produces": [
                    "text/html"
                ],
                "tags": [
                    "public"
                ],
                "summary": "Landing page",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "/.well-known/g8e/bin/{filename}": {
            "get": {
                "description": "Downloads the g8e node binary for the current platform (internal endpoint)",
                "produces": [
                    "application/octet-stream"
                ],
                "tags": [
                    "bootstrap"
                ],
                "summary": "Download node binary",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "file"
                        }
                    }
                }
            }
        },
        "/.well-known/g8e/pki/ca-bundle": {
            "get": {
                "description": "Returns the platform's root CA certificate bundle for trust establishment",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/x-pem-file"
                ],
                "tags": [
                    "pki"
                ],
                "summary": "Get CA bundle",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "/.well-known/g8e/pki/crl": {
            "get": {
                "description": "Returns the certificate revocation list",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "pki"
                ],
                "summary": "Get CRL",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    }
                }
            }
        },
        "/.well-known/g8e/pki/fingerprint": {
            "get": {
                "description": "Returns the platform's PKI fingerprint for verification",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "pki"
                ],
                "summary": "Get PKI fingerprint",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    }
                }
            }
        },
        "/.well-known/g8e/pki/trust-windows": {
            "get": {
                "description": "Returns the Windows CA trust bootstrap script (alias endpoint)",
                "produces": [
                    "text/plain"
                ],
                "tags": [
                    "bootstrap"
                ],
                "summary": "Bootstrap CA Windows script (alias)",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "/api/v1/data/blobs/{namespace}/{id}": {
            "get": {
                "description": "Retrieves a blob from the data store",
                "produces": [
                    "application/octet-stream"
                ],
                "tags": [
                    "data"
                ],
                "summary": "Get blob",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "file"
                        }
                    }
                }
            }
        },
        "/api/v1/pki/apps/delegated": {
            "post": {
                "description": "Mints a short-lived delegated credential for an app, binding both app and requestor identities (mTLS-authenticated)",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "pki"
                ],
                "summary": "Mint delegated app credential",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/gateway.AppEnrollResponse"
                        }
                    }
                }
            }
        },
        "/api/v1/pki/apps/enroll": {
            "post": {
                "description": "Enrolls an external app via PKI endpoint (identity-only enrollment)",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "pki"
                ],
                "summary": "PKI app enrollment",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/gateway.AppEnrollResponse"
                        }
                    }
                }
            }
        },
        "/api/v1/pki/certificates/revoke": {
            "post": {
                "description": "Revokes a certificate by serial number (internal mTLS endpoint)",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "pki"
                ],
                "summary": "Revoke certificate",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/models.StatusResponse"
                        }
                    }
                }
            }
        },
        "/api/v1/pki/csr/sign": {
            "post": {
                "description": "Signs a certificate signing request (internal mTLS endpoint)",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "pki"
                ],
                "summary": "Sign CSR",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/models.PKICSRSignResponse"
                        }
                    }
                }
            }
        },
        "/api/v1/pki/devices/enroll": {
            "post": {
                "description": "Enrolls a device via PKI endpoint",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "pki"
                ],
                "summary": "PKI device enrollment",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    }
                }
            }
        },
        "/bootstrap-ca": {
            "get": {
                "description": "Returns the Linux CA trust bootstrap script",
                "produces": [
                    "text/plain"
                ],
                "tags": [
                    "bootstrap"
                ],
                "summary": "Bootstrap CA Linux script",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "/bootstrap-ca-macos": {
            "get": {
                "description": "Returns the macOS CA trust bootstrap script",
                "produces": [
                    "text/plain"
                ],
                "tags": [
                    "bootstrap"
                ],
                "summary": "Bootstrap CA macOS script",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "/bootstrap-ca.ps1": {
            "get": {
                "description": "Returns the Windows CA trust bootstrap script",
                "produces": [
                    "text/plain"
                ],
                "tags": [
                    "bootstrap"
                ],
                "summary": "Bootstrap CA Windows script",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "/g8e-operator.ps1": {
            "get": {
                "description": "Returns the Windows operator deployment script",
                "produces": [
                    "text/plain"
                ],
                "tags": [
                    "deploy"
                ],
                "summary": "Deploy script Windows",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "/g8e-operator.sh": {
            "get": {
                "description": "Returns the Linux operator deployment script",
                "produces": [
                    "text/plain"
                ],
                "tags": [
                    "deploy"
                ],
                "summary": "Deploy script Linux",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "/health": {
            "get": {
                "description": "Returns the current health status of the gateway",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "health"
                ],
                "summary": "Health check",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/models.HealthResponse"
                        }
                    }
                }
            }
        },
        "/health/bootstrap": {
            "get": {
                "description": "Returns the current health status during bootstrap (no state root check)",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "health"
                ],
                "summary": "Bootstrap health check",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/models.HealthResponse"
                        }
                    }
                }
            }
        },
        "/state": {
            "get": {
                "description": "Returns the current state merkle root for envelope binding",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "state"
                ],
                "summary": "State root",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/models.StateResponse"
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "constants.GatewayMode": {
            "type": "string",
            "enum": [
                "gateway",
                "ok"
            ],
            "x-enum-varnames": [
                "GatewayModeGateway",
                "GatewayModeStatusOK"
            ]
        },
        "gateway.AppEnrollResponse": {
            "type": "object",
            "properties": {
                "app_cert": {
                    "type": "string"
                },
                "app_id": {
                    "type": "string"
                },
                "cert_chain": {
                    "type": "string"
                },
                "error": {
                    "type": "string"
                },
                "expires_at": {
                    "type": "string"
                },
                "success": {
                    "type": "boolean"
                },
                "trust_bundle": {
                    "type": "string"
                }
            }
        },
        "models.HealthResponse": {
            "type": "object",
            "properties": {
                "governance_ready": {
                    "type": "boolean"
                },
                "mode": {
                    "$ref": "#/definitions/constants.GatewayMode"
                },
                "state_merkle_root": {
                    "type": "string"
                },
                "status": {
                    "$ref": "#/definitions/constants.GatewayMode"
                },
                "version": {
                    "type": "string"
                }
            }
        },
        "models.PKICSRSignResponse": {
            "type": "object",
            "properties": {
                "certificate_chain_pem": {
                    "type": "string"
                },
                "certificate_pem": {
                    "type": "string"
                }
            }
        },
        "models.StateResponse": {
            "type": "object",
            "properties": {
                "state_merkle_root": {
                    "type": "string"
                }
            }
        },
        "models.StatusResponse": {
            "type": "object",
            "properties": {
                "status": {
                    "$ref": "#/definitions/constants.GatewayMode"
                }
            }
        }
    }
}