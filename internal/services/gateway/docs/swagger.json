        },
        "/api/v1/auth/passkeys/authenticate/verify": {
            "post": {
                "description": "Verifies a WebAuthn assertion response. Config-driven trust posture:\nmTLS (session-user binding, may mint web session in body), CLI bootstrap (public), or console (public, may mint web session + cookie).",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "passkey"
