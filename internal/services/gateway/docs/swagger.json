            "post": {
                "description": "Generates a WebAuthn registration challenge for CLI bootstrap (public, CORS-wrapped, first-credential-only enforced)",
                "consumes": ["application/json"],
                "produces": ["application/json"],
                "tags": ["passkey"],
                "summary": "Registration challenge (CLI bootstrap)",
                "responses": {
                    "200": {"description": "OK", "schema": {"type": "object"}},
                    "400": {"description": "Bad request"},
                    "403": {"description": "First-credential registration only"},
                    "405": {"description": "Method not allowed"}
                }
            }
        },
        "/api/v1/auth/passkeys/bootstrap/register/verify": {
            "post": {
                "description": "Verifies a WebAuthn attestation for CLI bootstrap (public, CORS-wrapped, first-credential-only enforced)",
