        "/api/v1/auth/passkeys/authenticate/challenge": {
            "post": {
                "description": "Generates a WebAuthn authentication challenge. Config-driven trust posture:\nmTLS (session-user binding), CLI bootstrap (public), or console (public).",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
