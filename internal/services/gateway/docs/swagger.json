        "/api/v1/auth/passkeys": {
            "get": {
                "description": "Lists passkey credentials for the authenticated web session user (WebSession-protected)",
                "produces": ["application/json"],
                "tags": ["passkey"],
                "summary": "List passkey credentials",
                "parameters": [
                    {
                        "type": "string",
                        "description": "User ID (from session context)",
                        "name": "user_id",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {"description": "OK", "schema": {"type": "object"}},
                    "401": {"description": "Unauthorized"},
                    "405": {"description": "Method not allowed"}
                }
            }
        },
        "/api/v1/auth/passkeys/authenticate/challenge": {
            "post": {
                "description": "Generates a WebAuthn authentication challenge (mTLS-protected, requires authenticated user)",
                "consumes": ["application/json"],
                "produces": ["application/json"],
                "tags": ["passkey"],
                "summary": "Authentication challenge (mTLS)",
                "responses": {
                    "200": {"description": "OK", "schema": {"type": "object"}},
                    "400": {"description": "Bad request"},
                    "401": {"description": "Unauthorized"},
                    "405": {"description": "Method not allowed"}
                }
            }
        },
        "/api/v1/auth/passkeys/authenticate/verify": {
            "post": {
                "description": "Verifies a WebAuthn assertion and may mint a web session (mTLS-protected, requires authenticated user)",
                "consumes": ["application/json"],
                "produces": ["application/json"],
                "tags": ["passkey"],
                "summary": "Authentication verify (mTLS)",
                "responses": {
                    "200": {"description": "OK", "schema": {"type": "object"}},
                    "400": {"description": "Bad request"},
                    "401": {"description": "Unauthorized"},
                    "405": {"description": "Method not allowed"}
                }
            }
        },
        "/api/v1/auth/passkeys/bootstrap/authenticate/challenge": {
            "post": {
                "description": "Generates a WebAuthn authentication challenge for CLI bootstrap (public, CORS-wrapped)",
                "consumes": ["application/json"],
                "produces": ["application/json"],
                "tags": ["passkey"],
                "summary": "Authentication challenge (CLI bootstrap)",
                "responses": {
                    "200": {"description": "OK", "schema": {"type": "object"}},
                    "400": {"description": "Bad request"},
                    "405": {"description": "Method not allowed"}
                }
            }
        },
        "/api/v1/auth/passkeys/bootstrap/authenticate/verify": {
            "post": {
                "description": "Verifies a WebAuthn assertion for CLI bootstrap (public, CORS-wrapped, no web session created)",
                "consumes": ["application/json"],
                "produces": ["application/json"],
                "tags": ["passkey"],
                "summary": "Authentication verify (CLI bootstrap)",
                "responses": {
                    "200": {"description": "OK", "schema": {"type": "object"}},
                    "400": {"description": "Bad request"},
                    "405": {"description": "Method not allowed"}
                }
            }
        },
