Output "/work/staging/frames/"

Set Shell "bash"
Set Width 1440
Set Height 900
Set FontFamily "JetBrains Mono"
Set FontSize 20
Set Padding 24
Set Framerate 30
Set TypingSpeed 30ms
Set Theme "Catppuccin Mocha"

Type "printf 'g8e terminal media synthetic replay\\nPRESENTATION CHECKPOINT: synthetic-complete\\n'"
Enter
Wait+Screen /PRESENTATION CHECKPOINT: synthetic-complete/
Screenshot "/work/staging/screenshots/synthetic-complete.png"
Sleep 1s
