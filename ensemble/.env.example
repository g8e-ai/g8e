# g8e Agentic Ensemble (g8ee) environment template.
# Copy to .env and fill in values. app/main.py loads .env via
# load_dotenv(override=False): variables already present in the process
# environment are not replaced. Do not commit .env to version control.
#
# The ensemble authenticates with its own enrolled app mTLS certificate.
# Reputation signing stays in the Gateway keystore and is requested over mTLS.
# The ensemble never mounts Operator secrets or holds an Operator session key.

# =============================================================================
# Gateway connectivity
# =============================================================================
# Plain-HTTP bootstrap surface used to submit the app enrollment request.
# When unset, it is derived from G8E_GATEWAY_HTTPS_URL (https -> http, :8443 ->
# :8080); startup fails closed if neither is set.

# Gateway HTTPS surface hosting the operator services the ensemble consumes
# (DB, KV, blob store, platform settings).
G8E_GATEWAY_HTTPS_URL=https://localhost:8443

# Gateway WebSocket pub/sub surface.
G8E_GATEWAY_PUBSUB_URL=wss://localhost:8443

# =============================================================================
# Runtime paths (all optional)
# =============================================================================
# Root of the .g8e runtime tree. Defaults to <project-root>/.g8e.
G8E_RUNTIME_DIR=

# PKI tree holding the enrolled app certificate. Defaults to
# <runtime-dir>/pki.
G8E_PKI_DIR=

# CA bundle for platform connections. Defaults to
# <pki-dir>/trust/g8eg-ca-bundle.pem.
G8E_CA_CERT_PATH=

# =============================================================================
# HTTP surface
# =============================================================================
# Comma-separated CORS origins permitted for cross-origin browser access.
G8E_ALLOWED_ORIGINS=

# WebAuthn relying-party configuration. Each defaults to the configured host
# (and gateway HTTPS port for the origin).
G8E_PASSKEY_RP_NAME=
G8E_PASSKEY_RP_ID=
G8E_PASSKEY_ORIGIN=

# =============================================================================
# LLM bootstrap defaults (all optional)
# =============================================================================
# Lowest-priority model configuration: platform DB settings and per-request
# overrides take precedence, but a fresh deployment can serve chat from
# environment variables alone. Providers: openai, anthropic, gemini, ollama,
# llamacpp, fake, g8e.
#
# Each role accepts PROVIDER, MODEL, ENDPOINT, and API_KEY. Unset roles fall
# back lite -> assistant -> primary. Role-specific values take precedence
# over the provider-level credentials below. A model name is required; no
# provider default is chosen automatically.
G8E_LLM_PRIMARY_PROVIDER=
G8E_LLM_PRIMARY_MODEL=
G8E_LLM_PRIMARY_ENDPOINT=
G8E_LLM_PRIMARY_API_KEY=

G8E_LLM_ASSISTANT_PROVIDER=
G8E_LLM_ASSISTANT_MODEL=
G8E_LLM_ASSISTANT_ENDPOINT=
G8E_LLM_ASSISTANT_API_KEY=

G8E_LLM_LITE_PROVIDER=
G8E_LLM_LITE_MODEL=
G8E_LLM_LITE_ENDPOINT=
G8E_LLM_LITE_API_KEY=

# Provider-level credentials and endpoints
G8E_LLM_OPENAI_API_KEY=
G8E_LLM_OPENAI_ENDPOINT=https://api.openai.com/v1
G8E_LLM_ANTHROPIC_API_KEY=
G8E_LLM_ANTHROPIC_ENDPOINT=https://api.anthropic.com
G8E_LLM_GEMINI_API_KEY=
G8E_LLM_OLLAMA_API_KEY=
G8E_LLM_OLLAMA_ENDPOINT=http://localhost:11434
G8E_LLM_LLAMACPP_API_KEY=
G8E_LLM_LLAMACPP_ENDPOINT=http://localhost:11444
# Jev-style decision model served by Ollama 0.35+ (POST /v1/systemone); uses the Ollama endpoint above.
G8E_LLM_JEV_MODEL=nimble

# =============================================================================
# Test settings (consumed by tests/conftest.py, not the running service)
# =============================================================================
# Set G8E_TEST_LLM_PRIMARY_PROVIDER to enable live-provider ai_integration
# tests. Unset roles fall back assistant -> primary and lite -> assistant.
G8E_TEST_LLM_PRIMARY_PROVIDER=
G8E_TEST_LLM_PRIMARY_MODEL=
G8E_TEST_LLM_PRIMARY_API_KEY=
G8E_TEST_LLM_PRIMARY_ENDPOINT=
G8E_TEST_LLM_ASSISTANT_PROVIDER=
G8E_TEST_LLM_ASSISTANT_MODEL=
G8E_TEST_LLM_ASSISTANT_API_KEY=
G8E_TEST_LLM_ASSISTANT_ENDPOINT=
G8E_TEST_LLM_LITE_PROVIDER=
G8E_TEST_LLM_LITE_MODEL=
G8E_TEST_LLM_LITE_API_KEY=
G8E_TEST_LLM_LITE_ENDPOINT=

# Live web-search tests require project ID, engine ID, and API key; location
# defaults to "global".
G8E_TEST_WEB_SEARCH_PROJECT_ID=
G8E_TEST_WEB_SEARCH_ENGINE_ID=
G8E_TEST_WEB_SEARCH_API_KEY=
G8E_TEST_WEB_SEARCH_LOCATION=

# Constants-parity tests resolve the protocol constants directory from this
# override before falling back to the in-tree relative path.
G8E_PROTOCOL_DIR=
