# g8ee Environment Variables Template
# Copy this file to .env and fill in your values
# DO NOT commit .env to version control

# =============================================================================
# Operator Connection Settings
# =============================================================================
G8E_OPERATOR_URL=https://localhost:8443
G8E_OPERATOR_PUBSUB_URL=wss://localhost:8443
G8E_OPERATOR_BLOB_URL=https://localhost:8443

# =============================================================================
# Application Settings
# =============================================================================
G8E_G8EE_URL=https://localhost:8443
G8E_GATEWAY_URL=https://localhost:8443
G8E_ALLOWED_ORIGINS=
G8E_LOG_LEVEL=INFO

# =============================================================================
# Authentication & Security
# =============================================================================
G8E_SESSION_ENCRYPTION_KEY=
G8E_INTERNAL_API_KEY=
G8E_OPERATOR_API_KEY=
G8E_OPERATOR_SESSION_ID=
G8E_AUDITOR_HMAC_KEY=

# =============================================================================
# Passkey/WebAuthn Settings
# =============================================================================
G8E_PASSKEY_RP_NAME=localhost
G8E_PASSKEY_RP_ID=localhost
G8E_PASSKEY_ORIGIN=https://localhost:8443

# =============================================================================
# LLM Provider Settings
# =============================================================================
# OpenAI
G8E_LLM_PRIMARY_PROVIDER=openai
G8E_LLM_MODEL=gpt-4
G8E_LLM_MAX_TOKENS=4096
G8E_LLM_COMMAND_GEN_ENABLED=true
G8E_LLM_COMMAND_GEN_AUDITOR=true
G8E_LLM_COMMAND_GEN_PASSES=5

# Provider-specific endpoints and keys
OPENAI_API_KEY=
OPENAI_ENDPOINT=https://api.openai.com/v1

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_ENDPOINT=https://api.anthropic.com

# Google Gemini
GEMINI_API_KEY=

# Ollama
OLLAMA_ENDPOINT=http://localhost:11434

# =============================================================================
# Search Settings (Vertex AI / Google Search)
# =============================================================================
G8E_VERTEX_SEARCH_ENABLED=false
G8E_VERTEX_SEARCH_PROJECT_ID=
G8E_VERTEX_SEARCH_ENGINE_ID=
G8E_VERTEX_SEARCH_LOCATION=global
G8E_VERTEX_SEARCH_API_KEY=

G8E_GOOGLE_SEARCH_ENABLED=false
G8E_GOOGLE_SEARCH_API_KEY=
G8E_GOOGLE_SEARCH_ENGINE_ID=

# =============================================================================
# Command Validation Settings
# =============================================================================
G8E_ENABLE_COMMAND_WHITELISTING=false
G8E_ENABLE_COMMAND_BLACKLISTING=true

# =============================================================================
# Session Settings
# =============================================================================
G8E_SESSION_TTL=28800
G8E_ABSOLUTE_SESSION_TIMEOUT=86400

# =============================================================================
# Docker Settings
# =============================================================================
G8E_DOCKER_GID=988

# =============================================================================
# Path Configuration
# =============================================================================
G8E_DATA_DIR=
G8E_DOCS_DIR=
G8E_PKI_DIR=
G8E_SECRETS_DIR=
G8E_PROTOCOL_DIR=

# =============================================================================
# Test Settings (for development/testing)
# =============================================================================
G8E_TEST_LLM_PRIMARY_PROVIDER=
G8E_TEST_LLM_PRIMARY_MODEL=
G8E_TEST_LLM_PRIMARY_API_KEY=
G8E_TEST_LLM_PRIMARY_ENDPOINT=
G8E_TEST_LLM_ASSISTANT_PROVIDER=
G8E_TEST_LLM_ASSISTANT_MODEL=
G8E_TEST_LLM_ASSISTANT_API_KEY=
G8E_TEST_LLM_ASSISTANT_ENDPOINT=
G8E_TEST_LLM_LITE_PROVIDER=
G8E_TEST_LLM_LITE_MODEL=
G8E_TEST_LLM_LITE_API_KEY=
G8E_TEST_LLM_LITE_ENDPOINT=
G8E_TEST_LLM_MAX_TOKENS=
G8E_TEST_OPERATOR_PUBSUB_URL=
