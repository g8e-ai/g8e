_menu() {
    if [[ ! -t 0 ]]; then _help; exit 0; fi
    while true; do
        clear
        echo -e "\033[1;34m  __ _   ___   ___  \033[0m"; echo -e "\033[1;34m / _\` | ( _ ) / _ \\ \033[0m"; echo -e "\033[1;34m| (_| | / _ \\|  __/ \033[0m"; echo -e "\033[1;34m \\__, | \\___/ \\___| \033[0m"; echo -e "\033[1;34m  ___/              \033[0m"
        echo ""; echo -e "\033[1;32m   Interactive g8e Platform Manager\033[0m"; echo ""
        echo "0) Setup Environment"
        echo ""
        echo "1) Gateway (g8eg)"
        echo "2) Operator (g8eo)"
        echo "3) Apps (g8ee)"
        echo "4) Protocol & Infrastructure"
        echo "5) Testing & Evaluation"
        echo ""
        echo "q) Exit"
        echo ""; read -p "Choose an option: " choice; echo ""
        case $choice in
            0) ./g8e setup ;;
            1) _gateway_menu ;;
            2) _operator_menu ;;
            3) _apps_menu ;;
            4) _protocol_menu ;;
            5) _testing_menu ;;
            q|Q) exit 0 ;;
            *) echo "Invalid option." ;;
        esac
    done
}

if [[ $# -eq 0 ]]; then _menu; exit 0; fi
if [[ "$1" == "--help" || "$1" == "-h" ]]; then _help; exit 0; fi

# Parse global authentication flags
API_KEY=""; DEVICE_TOKEN=""; COMPRESS_BUILD=""; filtered_args=(); i=1
while [[ $i -le $# ]]; do
    arg="${!i}"
    case "$arg" in
        --api-key|-k)   [[ $i -lt $# ]] && { ((i++)); API_KEY="${!i}"; }; ((i++)) ;;
        --device-token) [[ $i -lt $# ]] && { ((i++)); DEVICE_TOKEN="${!i}"; }; ((i++)) ;;
        --dev)          DEV_MODE=true; ((i++)) ;;
        --with-g8ee|-a) export G8E_WITH_G8EE=1; ((i++)) ;;
        -c)             COMPRESS_BUILD=1; ((i++)) ;;
        -*)             filtered_args+=("$arg"); ((i++)) ;;
        *)              while [[ $i -le $# ]]; do filtered_args+=("${!i}"); ((i++)); done; break ;;
    esac
done
set -- "${filtered_args[@]}"
TOP="$1"; SUB="${2:-}"

# Commands that require authentication
OPERATOR_SESSION_ID=""; USER_ID=""; OPERATOR_ID=""
AUTH_REQUIRED_COMMANDS=("security" "data" "mcp")
if [[ " ${AUTH_REQUIRED_COMMANDS[@]} " =~ " ${TOP} " ]]; then
    _require_authenticated
fi
if [[ "$TOP" == "operator" && ("$SUB" == "deploy" || "$SUB" == "stream" || "$SUB" == "reauth") ]]; then _require_authenticated; fi
if [[ "$TOP" == "platform" && "$SUB" == "settings" ]]; then _require_authenticated; fi
if [[ "$TOP" == "chat" ]]; then _require_authenticated; fi

# Dispatch to focused scripts
case "$TOP" in
    platform)   bash "$SCRIPT_DIR/scripts/cmd/platform.sh" "$SUB" "${@:3}" ;;
    apps)       exec bash "$SCRIPT_DIR/scripts/cmd/apps.sh" "$SUB" "${@:3}" ;;
    operator)   [[ -n "$COMPRESS_BUILD" ]] && export COMPRESS_BUILD; exec bash "$SCRIPT_DIR/scripts/cmd/operator.sh" "$SUB" "${@:3}" ;;
    chat)       exec bash "$SCRIPT_DIR/scripts/cmd/chat.sh" "$SUB" "${@:3}" ;;
    test)       exec bash "$SCRIPT_DIR/scripts/cmd/tests.sh" "$SUB" "${@:3}" ;;
    evals)      exec bash "$SCRIPT_DIR/scripts/cmd/evals.sh" "$SUB" "${@:3}" ;;
    demo)       exec bash "$SCRIPT_DIR/scripts/cmd/demo.sh" "$SUB" "${@:3}" ;;
    user)       exec bash "$SCRIPT_DIR/scripts/cmd/user.sh" "$SUB" "${@:3}" ;;
    setup)      exec bash "$SCRIPT_DIR/scripts/core/local_setup.sh" "$SUB" "${@:3}" ;;
    vars|login|logout|ssh|aws|search|llm|security|data|mcp)
                # Export auth credentials before exec since exec replaces the shell
                [[ -n "$G8E_OPERATOR_SESSION_ID" ]] && export G8E_OPERATOR_SESSION_ID
                [[ -n "$G8E_CLI_SESSION_ID" ]] && export G8E_CLI_SESSION_ID
                [[ -n "$G8E_USER_ID" ]] && export G8E_USER_ID
                [[ -n "$G8E_OPERATOR_ID" ]] && export G8E_OPERATOR_ID
                [[ -n "$G8E_CLI_CERT" ]] && export G8E_CLI_CERT
                [[ -n "$G8E_CLI_KEY" ]] && export G8E_CLI_KEY
                [[ -n "$G8E_OPERATOR_CERT" ]] && export G8E_OPERATOR_CERT
                [[ -n "$G8E_OPERATOR_KEY" ]] && export G8E_OPERATOR_KEY
                exec bash "$SCRIPT_DIR/scripts/cmd/infra.sh" "$TOP" "$SUB" "${@:3}" ;;
    *)
        echo "[g8e] unknown command: '$TOP'" >&2
        echo "  Run: ./g8e --help" >&2
        exit 1 ;;
esac
