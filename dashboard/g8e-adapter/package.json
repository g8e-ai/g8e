{
  "name": "g8e-adapter",
  "version": "0.1.0",
  "description": "g8e audited browser adapter — generator-neutral integration core for the observe frontend. Builders (Lovable, Notion, other) wrap this adapter; they do not rewrite its transport code.",
  "license": "BUSL-1.1",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc --build",
    "build:host": "vite build --config host/vite.config.ts",
    "dev:host": "vite --config host/vite.config.ts",
    "build:ref-ui": "vite build --config reference-ui/vite.config.ts",
    "dev:ref-ui": "vite --config reference-ui/vite.config.ts",
    "gen:contract-pack": "npm run build && node generator/gen-contract-pack.mjs",
    "gen:contract-pack:check": "node generator/gen-contract-pack.mjs --check",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "tsc --noEmit && tsc --noEmit -p host/tsconfig.json && tsc --noEmit -p cp-check.tsconfig.json && tsc --noEmit -p reference-ui/tsconfig.json",
    "clean": "rm -rf dist coverage host/dist reference-ui/dist"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.9"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
