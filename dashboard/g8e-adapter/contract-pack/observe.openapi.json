  "servers": [
    {
      "description": "Gateway base URL from runtime config",
      "url": "/api/v1"
    }
  ],
  "x-models": {
    "_authority": "agent",
    "_comment": "Canonical typed payloads for the observability dashboard event families. These are the data payloads carried inside SessionEventWire or BackgroundEventWire envelopes for the four dashboard event types: app.agent.status.updated, app.run.status.updated, ai.eval.run.completed, and ai.eval.metric.recorded. Producers emit these only after the corresponding state projection is persisted. All models exclude null fields on the wire.",
    "_consumers": [
      "agent",
      "cli",
      "browser"
    ],
    "agent_state_projection": {
      "_description": "Current lifecycle state of a single agent persona in the roster. Combines the static persona registry projection with the current agent-state snapshot.",
      "agent_id": {
        "description": "Stable agent identifier matching the persona registry",
        "required": true,
        "type": "string"
      },
      "display_name": {
        "description": "Human-readable agent name",
        "required": true,
        "type": "string"
      },
      "freshness": {
        "description": "Snapshot freshness status",
        "enum": [
          "observed",
          "stale",
          "unavailable"
        ],
        "required": true,
        "type": "string"
      },
      "model": {
        "description": "Model identifier when the agent is configured with a model",
        "required": false,
        "type": "string"
      },
      "observed_at": {
        "description": "UTC timestamp of the last status observation",
        "format": "iso8601",
        "required": true,
        "type": "string"
      },
      "role": {
        "description": "Agent role or persona (e.g. triage, sage, dash, auditor, warden, scribe, judge)",
        "required": true,
        "type": "string"
      },
      "run_id": {
        "description": "Owning run identifier when the agent is bound to a run",
        "required": false,
        "type": "string"
      },
      "schema_version": {
        "description": "Projection schema version identifier",
        "required": true,
        "type": "string"
      },
      "status": {
        "description": "Agent lifecycle state",
        "enum": [
          "idle",
          "queued",
          "running",
          "waiting",
          "completed",
          "failed",
          "offline"
        ],
        "required": true,
        "type": "string"
      },
      "task_id": {
        "description": "Active task identifier when the agent is executing a task",
        "required": false,
        "type": "string"
      },
      "throughput": {
        "description": "Tokens-per-second measurement. Unavailable until a real measured source exists.",
        "model": "observed_measurement",
        "required": false,
        "type": "object"
      }
    },
    "agent_status_updated_payload": {
      "_description": "Payload for app.agent.status.updated events. Reports the current lifecycle state of a single agent persona. Distinct from app.agent.activity.recorded, which is a governed document update for AgentActivityMetadata.",
      "agent_id": {
        "description": "Stable agent identifier",
        "required": true,
        "type": "string"
      },
      "display_name": {
        "description": "Human-readable agent name",
        "required": true,
        "type": "string"
      },
      "model": {
        "description": "Model identifier when the agent is configured with a model",
        "required": false,
        "type": "string"
      },
      "observed_at": {
        "description": "UTC timestamp of the observation",
        "format": "iso8601",
        "required": true,
        "type": "string"
      },
      "role": {
        "description": "Agent role or persona (e.g. triage, sage, dash, auditor, warden, scribe, judge)",
        "required": true,
        "type": "string"
      },
      "run_id": {
        "description": "Owning run identifier when the agent is bound to a run",
        "required": false,
        "type": "string"
      },
      "schema_version": {
        "description": "Payload schema version identifier",
        "required": true,
        "type": "string"
      },
      "status": {
        "description": "Agent lifecycle state",
        "enum": [
          "idle",
          "queued",
          "running",
          "waiting",
          "completed",
          "failed",
          "offline"
        ],
        "required": true,
        "type": "string"
      },
      "task_id": {
        "description": "Active task identifier when the agent is executing a task",
        "required": false,
        "type": "string"
      }
    },
    "download_artifact": {
      "_description": "An allowlisted generated public-safe artifact in the download catalog. Has fixed content type, byte size, SHA-256 hash, privacy classification, and authenticated download URL.",
      "artifact_id": {
        "description": "Stable artifact identifier used in the download URL path",
        "required": true,
        "type": "string"
      },
      "byte_size": {
        "required": true,
        "type": "integer"
      },
      "download_url": {
        "description": "Authenticated download URL path relative to the Gateway base URL",
        "required": true,
        "type": "string"
      },
      "filename": {
        "required": true,
        "type": "string"
      },
      "generated_at": {
        "format": "iso8601",
        "required": true,
        "type": "string"
      },
      "media_type": {
        "required": true,
        "type": "string"
      },
      "privacy_classification": {
        "description": "Disclosure classification. Only public_safe artifacts appear in the browser catalog.",
        "enum": [
          "public_safe",
          "restricted"
        ],
        "required": true,
        "type": "string"
      },
      "schema_version": {
        "required": true,
        "type": "string"
      },
      "sha256": {
        "description": "SHA-256 hash of the artifact content for integrity verification",
        "required": true,
        "type": "string"
      },
      "source_run_id": {
        "description": "Run that produced this artifact when applicable",
        "required": false,
        "type": "string"
      }
    },
    "eval_detail": {
      "_description": "Typed eval detail projection with manifest-safe identity, arm/model information, aggregate metrics, status, and verification boundary.",
      "arm_id": {
        "required": true,
        "type": "string"
      },
      "assigned_tasks": {
        "required": true,
        "type": "integer"
      },
      "completed_at": {
        "format": "iso8601",
        "required": false,
        "type": "string"
      },
      "metrics": {
        "items": "eval_metric_summary",
        "required": true,
        "type": "array"
      },
      "model_id": {
        "description": "Model identifier from the manifest role-to-model mapping. Omitted when not available.",
        "required": false,
        "type": "string"
      },
      "model_provider": {
        "description": "Model provider from the manifest. Omitted when not available.",
        "required": false,
        "type": "string"
      },
      "observed_at": {
        "format": "iso8601",
        "required": true,
        "type": "string"
      },
      "published_projection_sha256": {
        "required": false,
        "type": "string"
      },
      "receipt_count": {
        "required": true,
        "type": "integer"
      },
      "run_id": {
        "required": true,
        "type": "string"
      },
      "schema_version": {
        "required": true,
        "type": "string"
      },
      "status": {
        "enum": [
          "queued",
          "running",
          "waiting",
          "completed",
          "failed",
          "cancelled"
        ],
        "required": true,
        "type": "string"
      },
      "suite_id": {
        "required": true,
        "type": "string"
      },
      "suite_version": {
        "required": true,
        "type": "string"
      },
      "terminal_attempts": {
        "required": true,
        "type": "integer"
      },
      "verification_status": {
        "enum": [
          "projection_validated",
          "receipt_verification_not_applicable",
          "verified"
        ],
        "required": true,
        "type": "string"
      }
    },
    "eval_metric_recorded_payload": {
      "_description": "Payload for ai.eval.metric.recorded events. Reports a single registered metric value with its population, denominator, and verification status.",
      "denominator": {
        "description": "Denominator for the metric population",
        "required": true,
        "type": "integer"
      },
      "eligible": {
        "description": "Number of eligible items in the measured population",
        "required": true,
        "type": "integer"
      },
      "metric_id": {
        "description": "Registered metric identifier",
        "required": true,
        "type": "string"
      },
      "metric_version": {
        "description": "Metric schema version",
        "required": true,
        "type": "string"
      },
      "recorded_at": {
        "description": "UTC timestamp when the metric was recorded",
        "format": "iso8601",
        "required": true,
        "type": "string"
      },
      "run_id": {
        "description": "Stable eval run identifier",
        "required": true,
        "type": "string"
      },
      "schema_version": {
        "description": "Payload schema version identifier",
        "required": true,
        "type": "string"
      },
      "unit": {
        "description": "Metric unit",
        "required": true,
        "type": "string"
      },
      "value": {
        "description": "Metric value when available",
        "required": false,
        "type": "number"
      },
      "verification_status": {
        "description": "Honest verification boundary label. Never 'verified' until the complete verifier exists.",
        "enum": [
          "projection_validated",
          "receipt_verification_not_applicable",
          "verified"
        ],
        "required": true,
        "type": "string"
      }
    },
    "eval_metric_summary": {
      "_description": "A single registered metric in an eval detail projection.",
      "denominator": {
        "required": true,
        "type": "integer"
      },
      "eligible": {
        "required": true,
        "type": "integer"
      },
      "metric_id": {
        "required": true,
        "type": "string"
      },
      "metric_version": {
        "required": true,
        "type": "string"
      },
      "recorded_at": {
        "format": "iso8601",
        "required": false,
        "type": "string"
      },
      "schema_version": {
        "required": true,
        "type": "string"
      },
      "unit": {
        "required": true,
        "type": "string"
      },
      "value": {
        "description": "Metric value when available",
        "required": false,
        "type": "number"
      },
      "verification_status": {
        "enum": [
          "projection_validated",
          "receipt_verification_not_applicable",
          "verified"
        ],
        "required": true,
        "type": "string"
      }
    },
    "eval_run_completed_payload": {
      "_description": "Payload for ai.eval.run.completed events. Emitted only after the eval projection is persisted. Reports terminal aggregate counts and the verification boundary of a completed eval run.",
      "arm_id": {
        "description": "Eval arm identifier",
        "required": true,
        "type": "string"
      },
      "assigned_tasks": {
        "description": "Number of tasks assigned to the run",
        "required": true,
        "type": "integer"
      },
      "completed_at": {
        "description": "UTC timestamp when the eval run completed",
        "format": "iso8601",
        "required": true,
        "type": "string"
      },
      "published_projection_sha256": {
        "description": "SHA-256 hash of the persisted disclosure-safe projection",
        "required": true,
        "type": "string"
      },
      "receipt_count": {
        "description": "Number of receipts in the report",
        "required": true,
        "type": "integer"
      },
      "run_id": {
        "description": "Stable eval run identifier",
        "required": true,
        "type": "string"
      },
      "schema_version": {
        "description": "Payload schema version identifier",
        "required": true,
        "type": "string"
      },
      "suite_id": {
        "description": "Eval suite identifier",
        "required": true,
        "type": "string"
      },
      "suite_version": {
        "description": "Eval suite version",
        "required": true,
        "type": "string"
      },
      "terminal_attempts": {
        "description": "Number of attempts that reached a terminal state",
        "required": true,
        "type": "integer"
      },
      "verification_status": {
        "description": "Honest verification boundary label. Never 'verified' until the complete verifier exists.",
        "enum": [
          "projection_validated",
          "receipt_verification_not_applicable",
          "verified"
        ],
        "required": true,
        "type": "string"
      }
    },
    "eval_summary": {
      "_description": "Paginated eval run projection. Uses manifest role-to-model mappings and registered metrics with honest verification labels.",
      "arm_id": {
        "required": true,
        "type": "string"
      },
      "completed_at": {
        "format": "iso8601",
        "required": false,
        "type": "string"
      },
      "metric_count": {
        "description": "Number of registered metrics in the projection",
        "required": true,
