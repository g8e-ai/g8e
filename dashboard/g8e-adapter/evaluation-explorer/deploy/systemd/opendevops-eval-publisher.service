[Unit]
Description=OpenDevOps.ai continuous evaluation report publisher
Wants=g8e-public-mirror.service
After=g8e-public-mirror.service

[Service]
Type=simple
WorkingDirectory=/home/bob/g8e/dashboard/g8e-adapter/evaluation-explorer
ExecStart=/usr/bin/python3 /home/bob/g8e/dashboard/g8e-adapter/evaluation-explorer/scripts/bridge.py --report-root /home/bob/g8e/.local.dev/campaign/public-live --state-dir /home/bob/g8e/.local.dev/campaign/public-live-bridge --g8e-bin /home/bob/g8e/g8e --g8e-cwd /home/bob/g8e --poll-ms 1000 --retry-ms 5000
Restart=on-abnormal
RestartSec=5s
TimeoutStopSec=30s
UMask=0077
NoNewPrivileges=true

[Install]
WantedBy=default.target
