# g8e Docker Compose environment.
# Copy to .env and edit, or set inline: G8E_OLLAMA_ENDPOINT=http://192.168.1.2:11434 docker compose up -d --build
#
# Only secrets and user-specific endpoints or identities belong here. Platform
# configuration (ports, container names, model roles, service URLs) is fixed in
# docker-compose.yml and the g8e binary defaults; see docs/devs/devs.md INV-ENV-04.

# =============================================================================
# User-specific endpoints and identities
# =============================================================================

# Approved Ollama provider the Inference Operator calls. Required: Compose fails
# fast when unset. No Ollama daemon runs in the stack. The Inference Operator
# runs in a container, so localhost or 127.0.0.1 is the container itself, not
# your machine: use an address the container can reach (for example
# http://192.168.1.2:11434). Startup fails closed and the container restarts
# until the provider answers.
# G8E_OLLAMA_ENDPOINT=http://192.168.1.2:11434

# Hostname the browser uses to reach the gateway. Feeds approval links, host
# header validation, CORS, and passkey RP origins. Defaults to localhost; set it
# only when you reach the stack by another name (for example dev.g8e.local).
# G8E_HOSTNAME=localhost

# Same role as G8E_HOSTNAME for the User Gateway (g8ellama profile).
# G8E_USER_HOSTNAME=localhost
