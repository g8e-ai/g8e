# g8e Docker Compose environment overrides.
# Copy to .env and edit, or set inline: G8E_HTTP_PORT=18080 docker compose up -d --build

# Prefix for container names. Containers are named ${G8E_PREFIX}-gateway,
# ${G8E_PREFIX}-operator, ${G8E_PREFIX}-ensemble, ${G8E_PREFIX}-dashboard.
G8E_PREFIX=g8e

# Host port mapped to the gateway HTTP discovery surface (container port 8080).
# Used for health checks, CA bundle fetch, and platform enrollment submission.
G8E_HTTP_PORT=8080

# Host port mapped to the gateway HTTPS/mTLS surface (container port 8443).
# Used for MCP, A2A, governance envelopes, document store, WebSocket pub/sub, and the console SPA.
G8E_HTTPS_PORT=8443

# Host port mapped to the ensemble FastAPI API (container port 8000).
G8E_ENSEMBLE_PORT=8000

# Host port mapped to the dashboard Express server (container port 3000).
G8E_DASHBOARD_PORT=3000

# Public hostname the gateway advertises in approval links, host-header
# validation, CORS, and passkey RP origins. Defaults to localhost; set to a
# real hostname (e.g. dev.g8e.local) when the browser reaches the gateway via
# that hostname instead of localhost.
G8E_HOSTNAME=localhost

# =============================================================================
# g8ellama profile (docker compose --profile g8ellama up -d)
# =============================================================================
# Approved remote Ollama provider the Inference Node calls. Required when the
# g8ellama profile is active; Compose fails fast when unset. No Ollama daemon
# runs in the stack.
G8E_OLLAMA_ENDPOINT=http://localhost:11434

# Host ports mapped to the User Gateway surfaces (container ports 8080/8443)
# and the dashboard origin it advertises in CORS and passkey configuration.
G8E_USER_HTTP_PORT=8090
G8E_USER_HTTPS_PORT=8453
G8E_USER_DASHBOARD_PORT=3001

# Public hostname the User Gateway advertises, same role as G8E_HOSTNAME for
# the default gateway.
G8E_USER_HOSTNAME=localhost

# Model roles and Ollama keep-alive passed to the Inference Node via
# --inference-* flags.
G8E_INFERENCE_PRIMARY_MODEL=qwen3:4b
G8E_INFERENCE_ASSISTANT_MODEL=qwen3:1.7b
G8E_INFERENCE_LITE_MODEL=qwen3:0.6b
G8E_INFERENCE_KEEP_ALIVE=-1

# =============================================================================
# evaluation profile (docker compose --profile bootstrapped --profile evaluation)
# =============================================================================
# Frozen campaign identity for the dedicated inference operator. Required for
# scored assignments; without these the operator rejects campaign dispatch with
# HTTP 403 / campaign binding invalid. Must match the inventory used at
# `g8e eval campaign init`.
#
# Mini smoke (3 models, 225 cells) — see docs/guides/unified_stack.md:
#   G8E_INFERENCE_CAMPAIGN_ID=eval-smoke-mini
#   G8E_INFERENCE_MODEL_REGISTRY_DIGEST=ce4ce367289752cb39f5b34c431696ea5fa685825ac4392c493fc564e0be8854
#
# Dev full smoke (35 models, 2625 cells):
#   G8E_INFERENCE_CAMPAIGN_ID=phase1a-smoke
#   G8E_INFERENCE_MODEL_REGISTRY_DIGEST=bf99592643c56dc78a10c0ee5de59cf4d740fae0684cda6f9f9e40363959c50c
#
# First public homogeneous run (Genesis — fresh provider freeze at launch):
#   G8E_INFERENCE_CAMPAIGN_ID=eval-genesis-homogeneous
#   G8E_INFERENCE_MODEL_REGISTRY_DIGEST=<from eval inventory freeze>
G8E_INFERENCE_CAMPAIGN_ID=eval-smoke-mini
G8E_INFERENCE_MODEL_REGISTRY_DIGEST=ce4ce367289752cb39f5b34c431696ea5fa685825ac4392c493fc564e0be8854
