{
  "assignment_record_schemas": {
    "enriched_fields": [
      "scenario_summary",
      "semantic_grade_summaries",
      "activity_summary",
      "evidence_bindings",
      "verification_metadata",
      "benchmark_observations",
      "resource_summary"
    ],
    "envelope_versions": [
      "1.0.0",
      "1.1.0"
    ],
    "limits": {
      "max_activity_records": 128,
      "max_evidence_bindings": 32,
      "max_record_bytes": 262144,
      "max_text_bytes": 512
    },
    "message_types": [
      "PublicAssignmentLifecycleRecord",
      "PublicAssignmentResultProjection"
    ],
    "prohibited_claims": [
      "raw_prompt",
      "model_output",
      "private_evidence",
      "receipt_internals",
      "protocol_authorization",
      "individual_verification"
    ]
  },
  "event_types": {
    "error": {
      "payload_model": "public_stream_sentinel"
    },
    "event": {
      "payload_model": "public_safe_object",
      "sequence_source": "sse.id"
    },
    "key_revocation": {
      "payload_model": "public_key_revocation_record",
      "sequence_source": "sse.id"
    },
    "projection": {
      "payload_model": "public_safe_object",
      "sequence_source": "sse.id"
    },
    "proof_manifest": {
      "payload_model": "public_proof_manifest",
      "sequence_source": "sse.id"
    },
    "snapshot": {
      "payload_model": "public_feed_snapshot",
      "sequence_source": "payload.high_water_sequence"
    },
    "truncated": {
      "payload_model": "public_stream_sentinel"
    }
  },
  "schema_version": "1.0.0",
  "sentinel_models": {
    "public_stream_sentinel": {
      "reason": {
        "required": true,
        "type": "string"
      }
    }
  }
}
