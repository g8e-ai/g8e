{
  "mcpServers": {
    "g8e-gateway": {
      "transport": {
        "type": "http",
        "url": "https://g8e.local:8443/mcp"
      },
      "tls": {
        "clientCertificate": "/path/to/cli.crt",
        "clientKey": "/path/to/cli.key",
        "caCertificate": "/path/to/g8eg-ca-bundle.pem",
        "verifyServer": true,
        "verifyHostname": "g8e.local"
      },
      "capabilities": {
        "tools": true,
        "resources": true,
        "prompts": true
      },
      "description": "g8e Gateway MCP endpoint",
      "notes": [
        "mTLS is required for production access."
      ]
    }
  }
}
