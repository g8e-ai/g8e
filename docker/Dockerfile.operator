FROM alpine:3.21

# Install runtime dependencies
RUN apk add --no-cache ca-certificates tzdata && \
    rm -rf /var/cache/apk/*

# Create non-root user
RUN addgroup -g 1000 g8e && \
    adduser -D -u 1000 -G g8e g8e

# Set up directories
WORKDIR /home/g8eo
RUN mkdir -p /home/g8eo/.g8e/pki /home/g8eo/.g8e/secrets /home/g8eo/.g8e/data && \
    chown -R g8e:g8e /home/g8eo

# Copy pre-built binary from host
COPY bin/g8e-linux-amd64 /home/g8eo/g8e-linux-amd64
RUN chmod +x /home/g8eo/g8e-linux-amd64 && \
    chown g8e:g8e /home/g8eo/g8e-linux-amd64

# Switch to non-root user
USER g8e

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD /home/g8eo/g8e-linux-amd64 --version || exit 1

# Expose Operator ports
# 9000: HTTPS mTLS API
# 9001: Bootstrap TLS (CSR enrollment)
# 9002: Public browser/BYO bootstrap
EXPOSE 9000 9001 9002

# Operator mode (connects to gateway via -e/--endpoint)
# Operators connect to gateway0:9000 via docker network DNS
ENTRYPOINT ["/home/g8eo/g8e-linux-amd64", "-e", "gateway0:9000", "--data-dir", "/home/g8eo/.g8e/data", "--pki-dir", "/home/g8eo/.g8e/pki", "--secrets-dir", "/home/g8eo/.g8e/secrets"]
