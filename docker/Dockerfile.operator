FROM alpine:3.21

# Install runtime dependencies
RUN apk add --no-cache ca-certificates tzdata && \
    rm -rf /var/cache/apk/*

# Create non-root user
RUN addgroup -g 1000 g8e && \
    adduser -D -u 1000 -G g8e g8e

# Set up directories
WORKDIR /g8e
RUN mkdir -p /g8e/.g8e/pki /g8e/.g8e/secrets /g8e/.g8e/data && \
    chown -R g8e:g8e /g8e

# Copy pre-built binary from host
COPY g8e /g8e/g8e
RUN chmod +x /g8e/g8e && \
    chown g8e:g8e /g8e/g8e

# Switch to non-root user
USER g8e

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD g8e --version || exit 1

# Expose operator ports
# 9000: HTTPS mTLS API
# 9001: Bootstrap TLS (CSR enrollment)
# 9002: Public browser/BYO bootstrap
EXPOSE 9000 9001 9002

# Operator listen mode
ENTRYPOINT ["/g8e/g8e", "--listen"]
