FROM alpine:3.21

# Install runtime dependencies
RUN apk add --no-cache ca-certificates tzdata && \
    rm -rf /var/cache/apk/*

# Create non-root user
RUN addgroup -g 1000 g8e && \
    adduser -D -u 1000 -G g8e g8e

# Set up directories
WORKDIR /home/g8eg
RUN mkdir -p /home/g8eg/.g8e/pki /home/g8eg/.g8e/secrets /home/g8eg/.g8e/data && \
    chown -R g8e:g8e /home/g8eg

# Copy pre-built binary from host
COPY bin/g8e-linux-amd64 /home/g8eg/g8e-linux-amd64
RUN chmod +x /home/g8eg/g8e-linux-amd64 && \
    chown g8e:g8e /home/g8eg/g8e-linux-amd64

# Switch to non-root user
USER g8e

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD /home/g8eg/g8e-linux-amd64 gw status || exit 1

# Expose gateway ports
# 9000: HTTPS mTLS API
# 9001: Bootstrap TLS (CSR enrollment)
# 9002: Public browser/BYO bootstrap
EXPOSE 9000 9001 9002

# Gateway mode: L1 enforced, L2/L3 audited (default posture)
# Override with --consensus or --notary for stricter postures
ENTRYPOINT ["/home/g8eg/g8e-linux-amd64", "gw", "start"]
