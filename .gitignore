# ==============================================================================
# g8e Gateway Git Ignore
# Optimized for Air-Gap (Local-First) & Zero-Bloat
# ==============================================================================

# --- System & OS ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
Desktop.ini
*~
*.tmp
*.temp
*.bak

# --- IDEs & Editors ---
.idea/
.vscode/
*.swp
*.swo
.project
.pydevproject
.settings/
*.iml
.devin/
.devin/*
.local.dev/
.loal.dev/*

# --- Logs & Performance ---
*.log
*.logs
logs/
.cache/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
.tox/
.nox/
coverage.xml
coverage.html
coverage.txt

# --- Runtime State & Persistence (CRITICAL: DO NOT COMMIT) ---
.g8e
.g8e/
**/.g8e*
g8e
g8e.sha256
.local.dev/
/data/
/db/
*.db
*.sqlite
*.sqlite3
*.sqlite3-journal

# --- Secrets & PKI (CRITICAL: DO NOT COMMIT) ---
.env
.env.*
*.key
*.pem
*.crt
*.secret
*.p12
*.pfx
ssl/
.ssl/

# --- Build Artifacts & Binaries ---
bin/
build/
dist/
target/
*.exe
*.exe~
*.dll
*.so
*.dylib
*.test
*.out
*.manifest
*.spec

# --- g8e Specific Binaries ---
buf
# Go binaries in cmd/ directories
cmd/g8ea/g8ea
cmd/g8eo/g8eo
cmd/chaos_tester/chaos_tester
cmd/auditor/auditor

# --- Build-time artifacts ---
# Temporary build directory for docs embedding
.build/

# --- Go Gateway ---
go.work
go.work.sum
# Note: vendor/ is INTENTIONALLY NOT IGNORED to support air-gapped builds
# If you want to exclude it, uncomment the next line:
# vendor/

# --- Python Engine & Evals ---
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
ENV/
*.egg-info/
*.egg
__pypackages__/
.Python
# Engine Models (GGUF/weights - too large for git, stage out-of-band)
services/g8ee/models/*.gguf
services/g8ee/models/*.bin
!services/g8ee/models/README.md

# --- Protocol Generation ---
# Generated code is committed to avoid tool dependencies in air-gap
# protocol/python/g8e_protocol/
# protocol/go/g8e_protocol/
# Auto-generated protobuf documentation
protocol/docs/reference/api/
protocol/proto/docs/reference/api/

# --- Deployment ---
.dockerignore
/site
