# ==============================================================================
# g8e Gateway Git Ignore
# ==============================================================================

# --- System & OS ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
Desktop.ini
*~
*.tmp
*.temp
*.bak

# --- IDEs & Editors ---
.idea/
.vscode/
*.swp
*.swo
.project
.pydevproject
.settings/
*.iml
.devin/
.devin/*
.local.dev/
.local.dev/*

# --- Logs & Performance ---
*.log
*.logs
logs/
.cache/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
.tox/
.nox/
coverage.xml
coverage.html
coverage.txt

# --- Runtime State & Persistence ---
.g8e
.g8e/
**/.g8e*
g8e.sha256
/data/
/db/
*.db
*.sqlite
*.sqlite3
*.sqlite3-journal
*-shm
*-wal


# --- Secrets & PKI ---
.env
.env.*
*.key
*.pem
*.crt
*.secret
*.p12
*.pfx
ssl/
.ssl/

# --- Build Artifacts & Binaries ---
bin/
build/
dist/
target/
*.exe
*.exe~
*.dll
*.so
*.dylib
*.test
*.out
*.manifest
*.spec

# --- reports  ---
reports/
reports/*

# Binaries
/g8e
*buf
*operator
# Exception: don't ignore vendored operator proto package
!vendor/github.com/g8e-ai/g8e/protocol/proto/g8e/operator/
!vendor/github.com/g8e-ai/g8e/protocol/proto/g8e/operator/**

# --- Build-time artifacts ---
# Temporary build directory for docs embedding
.build/

# --- Go Gateway ---
go.work
go.work.sum
# Note: vendor/ is INTENTIONALLY NOT IGNORED to support air-gapped builds
# If you want to exclude it, uncomment the next line:
# vendor/

# --- Python Engine & Evals ---
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
ENV/
*.egg-info/
*.egg
__pypackages__/
.Python


# --- Deployment ---
.dockerignore
/site

# --- Claude Code ---
CLAUDE.md
.claude/
.claude/*

# --- GEMINI ---
GEMINI.md
.gemini/
.gemini/*

# --- Integration test results (persisted per run) ---
test-results/


# --- Auditor output (generated during tests) ---
auditor-out/
auditor-out/*