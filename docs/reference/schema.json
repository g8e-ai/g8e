{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "g8e Model Context Protocol (MCP) Schema",
  "description": "JSON Schema for the Model Context Protocol (MCP) as implemented by the g8e Gateway. This schema defines the JSON-RPC 2.0 messages supported for tool execution, resource access, and prompt management, including g8e-specific extensions like A2A skill calls. The gateway accepts notifications/initialized and notifications/* methods, returning HTTP 202 Accepted with no response body.",
  "type": "object",
  "required": ["jsonrpc", "method"],
  "properties": {
    "jsonrpc": {
      "const": "2.0",
      "type": "string"
    },
    "id": {
      "oneOf": [
        { "type": "string" },
        { "type": "integer" }
      ]
    },
    "method": {
      "type": "string"
    },
    "params": {
      "type": "object"
    }
  },
  "$defs": {
    "InitializeRequest": {
      "description": "The first request sent by the client to negotiate protocol version and capabilities.",
      "properties": {
        "protocolVersion": {
          "type": "string",
          "description": "The version of the MCP protocol the client wants to use."
        },
        "capabilities": {
          "$ref": "#/$defs/ClientCapabilities"
        },
        "clientInfo": {
          "type": "object",
          "properties": {
            "name": { "type": "string" },
            "version": { "type": "string" }
          },
          "required": ["name", "version"]
        }
      },
      "required": ["protocolVersion", "capabilities", "clientInfo"],
      "type": "object"
    },
    "InitializeParams": {
      "description": "The subset of initialize params negotiated by the g8e gateway.",
      "properties": {
        "protocolVersion": {
          "type": "string",
          "description": "The version of the MCP protocol the client wants to use."
        }
      },
      "type": "object"
    },
    "InitializeResult": {
      "description": "The server's response to an initialize request.",
      "properties": {
        "protocolVersion": {
          "type": "string",
          "description": "The version of the MCP protocol the server selected."
        },
        "capabilities": {
          "$ref": "#/$defs/ServerCapabilities"
        },
        "serverInfo": {
          "type": "object",
          "properties": {
            "name": { "type": "string" },
            "version": { "type": "string" }
          },
          "required": ["name", "version"]
        },
        "instructions": {
          "type": "string",
          "description": "Instructions for the client on how to use the server."
        }
      },
      "required": ["protocolVersion", "capabilities", "serverInfo"],
      "type": "object"
    },
    "ServerCapabilities": {
      "description": "Capabilities supported by the g8e Gateway server.",
      "properties": {
        "tools": {
          "type": "object",
          "properties": {
            "listChanged": { "type": "boolean", "const": true }
          },
          "required": ["listChanged"]
        },
        "resources": { "type": "object" },
        "prompts": { "type": "object" }
      },
      "type": "object"
    },
    "ToolsCapability": {
      "description": "Tools capability configuration.",
      "properties": {
        "listChanged": { "type": "boolean" }
      },
      "type": "object"
    },
    "ResourcesCapability": {
      "description": "Resources capability configuration.",
      "type": "object"
    },
    "PromptsCapability": {
      "description": "Prompts capability configuration.",
      "type": "object"
    },
    "ClientCapabilities": {
      "description": "Capabilities supported by the MCP client.",
      "type": "object"
    },
    "ListToolsResult": {
      "description": "The result of a tools/list request.",
      "properties": {
        "tools": {
          "type": "array",
          "items": { "$ref": "#/$defs/Tool" }
        }
      },
      "required": ["tools"],
      "type": "object"
    },
    "Tool": {
      "description": "Definition of a tool that can be called by the client.",
      "properties": {
        "name": { "type": "string", "description": "The unique name of the tool." },
        "description": { "type": "string", "description": "A human-readable description of the tool." },
        "inputSchema": {
          "$ref": "#/$defs/InputSchema"
        }
      },
      "required": ["name"],
      "type": "object"
    },
    "InputSchema": {
      "description": "JSON Schema for tool input validation.",
      "properties": {
        "type": { "type": "string", "description": "Must be 'object' for tool inputs." },
        "properties": {
          "type": "object",
          "description": "Map of property names to their schema definitions.",
          "additionalProperties": { "$ref": "#/$defs/PropertySchema" }
        },
        "required": {
          "type": "array",
          "items": { "type": "string" },
          "description": "List of required property names."
        }
      },
      "required": ["type"],
      "type": "object"
    },
    "PropertySchema": {
      "description": "JSON Schema property definition.",
      "properties": {
        "type": { "type": "string" },
        "description": { "type": "string" },
        "enum": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "required": ["type"],
      "type": "object"
    },
    "CallToolRequest": {
      "description": "Arguments for a tools/call request.",
      "properties": {
        "name": { "type": "string", "description": "The name of the tool to call." },
        "arguments": {
          "description": "The arguments to pass to the tool, matching its inputSchema. Accepts any valid JSON value (object, array, string, number, boolean, or null)."
        }
      },
      "required": ["name"],
      "type": "object"
    },
    "CallToolResult": {
      "description": "The result of a tool execution.",
      "properties": {
        "content": {
          "type": "array",
          "items": { "$ref": "#/$defs/TextContent" }
        },
        "isError": {
          "type": "boolean",
          "description": "True if the tool execution failed."
        }
      },
      "required": ["content"],
      "type": "object"
    },
    "TextContent": {
      "description": "A text-based content block in a tool response or message.",
      "properties": {
        "type": { "const": "text", "type": "string" },
        "text": { "type": "string" }
      },
      "required": ["type", "text"],
      "type": "object"
    },
    "ListResourcesResult": {
      "description": "The result of a resources/list request.",
      "properties": {
        "resources": {
          "type": "array",
          "items": { "$ref": "#/$defs/Resource" }
        }
      },
      "required": ["resources"],
      "type": "object"
    },
    "Resource": {
      "description": "A resource provided by the server.",
      "properties": {
        "uri": { "type": "string", "description": "The unique URI of the resource." },
        "name": { "type": "string", "description": "The name of the resource." },
        "description": { "type": "string" },
        "mimeType": { "type": "string" },
        "metadata": {
          "$ref": "#/$defs/Metadata"
        }
      },
      "required": ["uri", "name"],
      "type": "object"
    },
    "Metadata": {
      "description": "Typed metadata for MCP resources and prompts.",
      "properties": {
        "custom": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        }
      },
      "type": "object"
    },
    "ListResourcesRequest": {
      "description": "Parameters for the resources/list method.",
      "properties": {
        "cursor": {
          "type": "string",
          "description": "Optional cursor for pagination."
        }
      },
      "type": "object"
    },
    "ReadResourceRequest": {
      "description": "Parameters for the resources/read method.",
      "properties": {
        "uri": {
          "type": "string",
          "description": "The URI of the resource to read."
        }
      },
      "required": ["uri"],
      "type": "object"
    },
    "ReadResourceResult": {
      "description": "The result of a resources/read request.",
      "properties": {
        "contents": {
          "type": "array",
          "items": { "$ref": "#/$defs/TextContent" }
        },
        "mimeType": { "type": "string" }
      },
      "required": ["contents"],
      "type": "object"
    },
    "ListPromptsResult": {
      "description": "The result of a prompts/list request.",
      "properties": {
        "prompts": {
          "type": "array",
          "items": { "$ref": "#/$defs/Prompt" }
        }
      },
      "required": ["prompts"],
      "type": "object"
    },
    "Prompt": {
      "description": "A prompt template provided by the server.",
      "properties": {
        "name": { "type": "string" },
        "description": { "type": "string" },
        "arguments": {
          "type": "array",
          "items": { "$ref": "#/$defs/PromptArgument" }
        },
        "metadata": {
          "$ref": "#/$defs/Metadata"
        }
      },
      "required": ["name"],
      "type": "object"
    },
    "ListPromptsRequest": {
      "description": "Parameters for the prompts/list method.",
      "properties": {
        "cursor": {
          "type": "string",
          "description": "Optional cursor for pagination."
        }
      },
      "type": "object"
    },
    "GetPromptRequest": {
      "description": "Parameters for the prompts/get method.",
      "properties": {
        "name": {
          "type": "string",
          "description": "The name of the prompt to get."
        },
        "arguments": {
          "type": "object",
          "additionalProperties": { "type": "string" },
          "description": "Arguments to fill in the prompt template."
        }
      },
      "required": ["name"],
      "type": "object"
    },
    "PromptArgument": {
      "description": "An argument for a prompt template.",
      "properties": {
        "name": { "type": "string" },
        "description": { "type": "string" },
        "required": { "type": "boolean" }
      },
      "required": ["name"],
      "type": "object"
    },
    "GetPromptResult": {
      "description": "The result of a prompts/get request.",
      "properties": {
        "description": { "type": "string" },
        "messages": {
          "type": "array",
          "items": { "$ref": "#/$defs/PromptMessage" }
        }
      },
      "type": "object"
    },
    "PromptMessage": {
      "description": "A message in a prompt template response.",
      "properties": {
        "role": { "type": "string" },
        "content": { "$ref": "#/$defs/TextContent" }
      },
      "required": ["role", "content"],
      "type": "object"
    },
    "JSONRPCError": {
      "description": "A JSON-RPC 2.0 error object.",
      "properties": {
        "code": { "type": "integer" },
        "message": { "type": "string" },
        "data": {
          "description": "Additional error data. Accepts any valid JSON value."
        }
      },
      "required": ["code", "message"],
      "type": "object"
    },
    "JSONRPCResponse": {
      "description": "A JSON-RPC 2.0 response object.",
      "properties": {
        "jsonrpc": { "const": "2.0", "type": "string" },
        "result": {
          "description": "The result payload. Accepts any valid JSON value whose shape depends on the method."
        },
        "error": { "$ref": "#/$defs/JSONRPCError" },
        "id": {
          "oneOf": [
            { "type": "string" },
            { "type": "integer" }
          ]
        }
      },
      "required": ["jsonrpc", "id"],
      "type": "object"
    },
    "PingRequest": {
      "description": "A ping request to check server liveness.",
      "type": "object"
    },
    "PingResult": {
      "description": "The result of a ping request.",
      "type": "object"
    },
    "ResourceTemplate": {
      "description": "An MCP resource template with a URI pattern.",
      "properties": {
        "uriTemplate": { "type": "string", "description": "The URI template pattern for the resource." },
        "name": { "type": "string", "description": "The name of the resource template." },
        "description": { "type": "string" },
        "mimeType": { "type": "string" }
      },
      "required": ["uriTemplate", "name"],
      "type": "object"
    },
    "ListResourceTemplatesResult": {
      "description": "The result of a resources/templates/list request. The g8e Gateway returns an empty array as no resource templates are exposed.",
      "properties": {
        "resourceTemplates": {
          "type": "array",
          "items": { "$ref": "#/$defs/ResourceTemplate" }
        }
      },
      "required": ["resourceTemplates"],
      "type": "object"
    },
    "NotificationAccepted": {
      "description": "The gateway accepts notifications/initialized and notifications/* methods, returning HTTP 202 Accepted with no JSON-RPC response body. Notifications carry no result or error payload.",
      "type": "null"
    },
    "A2ACallRequest": {
      "description": "Arguments for an a2a/call request (g8e extension).",
      "properties": {
        "skill_name": { "type": "string", "description": "The name of the A2A skill to call." },
        "payload": {
          "description": "The payload to pass to the A2A skill. Accepts any valid JSON value."
        },
        "execution_id": { "type": "string", "description": "Optional unique execution ID." }
      },
      "required": ["skill_name", "payload"],
      "type": "object"
    },
    "A2ACallResult": {
      "description": "The result of an A2A skill execution.",
      "oneOf": [
        { "$ref": "#/$defs/A2ASuccessResponse" },
        { "$ref": "#/$defs/A2ASuspensionResponse" }
      ]
    },
    "A2ASuccessResponse": {
      "description": "Successful A2A skill execution response.",
      "properties": {
        "id": { "type": "string" },
        "result": {
          "description": "The action receipt from the operator (protobuf type).",
          "type": "object"
        }
      },
      "required": ["id", "result"],
      "type": "object"
    },
    "A2ADownstreamRequest": {
      "description": "Request sent to a downstream A2A server.",
      "properties": {
        "skill_name": { "type": "string" },
        "payload": {
          "description": "The payload to send to the downstream A2A server. Accepts any valid JSON value."
        },
        "execution_id": { "type": "string" }
      },
      "required": ["skill_name", "payload"],
      "type": "object"
    },
    "A2ASuspensionResponse": {
      "description": "A2A skill execution suspended for authorization.",
      "properties": {
        "id": { "type": "string" },
        "status": { "type": "string", "const": "suspended" },
        "tx_hash": { "type": "string" },
        "approval_url": { "type": "string" },
        "message": { "type": "string" }
      },
      "required": ["id", "status", "tx_hash", "approval_url"],
      "type": "object"
    }
  }
}
