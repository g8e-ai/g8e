{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "g8e Gateway MCP HTTP Client Configuration",
  "description": "Configuration template for connecting MCP clients to the g8e Gateway plain HTTP endpoint (port 8442). This endpoint does not require mTLS credentials but may have different security policies.",
  "version": "v1",
  "type": "object",
  "properties": {
    "mcpServers": {
      "type": "object",
      "description": "MCP server configuration for g8e Gateway HTTP endpoint",
      "properties": {
        "g8e-gateway-http": {
          "type": "object",
          "description": "g8e Gateway plain HTTP MCP server configuration",
          "properties": {
            "transport": {
              "type": "object",
              "description": "HTTP transport configuration",
              "properties": {
                "type": {
                  "type": "string",
                  "const": "http",
                  "description": "Transport type: HTTP (no TLS)"
                },
                "url": {
                  "type": "string",
                  "format": "uri",
                  "description": "Gateway HTTP endpoint URL (default: http://localhost:8442/api/mcp/v1)",
                  "default": "http://{{GATEWAY_IP}}:8442/api/mcp/v1"
                }
              },
              "required": ["type", "url"]
            },
            "capabilities": {
              "type": "object",
              "description": "MCP server capabilities",
              "properties": {
                "tools": {
                  "type": "boolean",
                  "description": "Support for tool invocation",
                  "default": true
                },
                "resources": {
                  "type": "boolean",
                  "description": "Support for resource operations",
                  "default": true
                },
                "prompts": {
                  "type": "boolean",
                  "description": "Support for prompt templates",
                  "default": true
                }
              }
            },
            "security": {
              "type": "object",
              "description": "Security configuration for HTTP endpoint",
              "properties": {
                "mode": {
                  "type": "string",
                  "enum": ["rate-limited", "development"],
                  "description": "Security mode: rate-limited (production) or development (relaxed)",
                  "default": "rate-limited"
                },
                "rateLimit": {
                  "type": "object",
                  "description": "Rate limiting configuration",
                  "properties": {
                    "requestsPerSecond": {
                      "type": "number",
                      "description": "Maximum requests per second",
                      "default": 5.0
                    },
                    "burst": {
                      "type": "integer",
                      "description": "Burst size for rate limiter",
                      "default": 10
                    }
                  }
                },
                "warning": {
                  "type": "string",
                  "description": "Security warning for HTTP endpoint",
                  "default": "Plain HTTP endpoint does not provide mTLS authentication. Use the mTLS endpoint (port 8440) for production workloads."
                }
              }
            }
          },
          "required": ["transport"]
        }
      }
    }
  },
  "required": ["mcpServers"],
  "examples": [
    {
      "mcpServers": {
        "g8e-gateway-http": {
          "transport": {
            "type": "http",
            "url": "http://{{GATEWAY_IP}}:8442/api/mcp/v1"
          },
          "capabilities": {
            "tools": true,
            "resources": true,
            "prompts": true
          },
          "security": {
            "mode": "rate-limited",
            "rateLimit": {
              "requestsPerSecond": 5.0,
              "burst": 10
            },
            "warning": "Plain HTTP endpoint does not provide mTLS authentication. Use the mTLS endpoint (port 8440) for production workloads."
          }
        }
      }
    }
  ]
}
